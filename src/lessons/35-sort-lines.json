{
  "slug": "sort-lines",
  "title": "Sorting Lines",
  "category": "ex-commands",
  "order": 35,
  "intro": "`:sort` sorts lines alphabetically, the whole file by default or just a range like `:2,4sort`. `:sort!` reverses the order, `:sort n` sorts by the first number on each line (so 9 comes before 10), and `:sort u` also removes duplicate lines.",
  "summary": "Sort imports, lists and numbers without leaving Vim.",
  "keys": [
    ":sort",
    ":sort!",
    ":sort n",
    ":sort u"
  ],
  "exercises": [
    {
      "id": "sort-lines-1",
      "type": "edit",
      "instruction": "Alphabetise the list: `:sort` + `Enter`.",
      "initialCode": "pear\napple\nmango",
      "initialCursor": {
        "line": 0,
        "ch": 0
      },
      "goal": {
        "buffer": "apple\nmango\npear"
      },
      "parKeystrokes": 6,
      "hints": [
        "With no range, `:sort` sorts every line."
      ]
    },
    {
      "id": "sort-lines-2",
